# WatchParty Client Environment Variables

# For Local Development (Vite proxies /api and /socket.io to backend):
# VITE_API_URL=/api
# VITE_SOCKET_URL=http://localhost:5000

# For Production Deployment on Vercel (point to your Render backend URL):
# VITE_API_URL=https://your-watchparty-backend.onrender.com/api
# VITE_SOCKET_URL=https://your-watchparty-backend.onrender.com

VITE_API_URL=/api
VITE_SOCKET_URL=http://localhost:5000
