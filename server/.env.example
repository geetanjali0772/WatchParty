# WatchParty Server Environment Variables

# Port (Render sets this dynamically via $PORT, defaults to 5000 locally)
PORT=5000

# MongoDB Connection String (Atlas URI for production or local mongodb)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/watchparty?retryWrites=true&w=majority

# Allowed Frontend Origins (comma-separated, wildcards allowed e.g. https://*.vercel.app, or *)
CLIENT_URL=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174,https://your-watchparty-app.vercel.app

# Environment Mode ('development' or 'production')
NODE_ENV=development

# JWT Secret (MUST be at least 32 characters long for security validation)
JWT_SECRET=your_jwt_secret_min_32_characters_long_placeholder

# JWT Token Expiration
JWT_EXPIRES_IN=7d

# Optional Cookie overrides (defaults to 'none' in production, 'lax' in development)
# COOKIE_SAME_SITE=none
# COOKIE_SECURE=true
